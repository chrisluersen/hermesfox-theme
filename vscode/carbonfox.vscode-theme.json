{
  "$schema": "vscode://schemas/color-theme",
  "name": "Carbonfox",
  "type": "dark",
  "colors": {
    "editor.background": "#161616",
    "editor.foreground": "#f2f4f8",
    "editorLineNumber.foreground": "#797a7e",
    "editorLineNumber.activeForeground": "#f2f4f8",
    "editorCursor.foreground": "#f2f4f8",
    "editor.selectionBackground": "#2a2a2a",
    "editor.lineHighlightBackground": "#1f1f1f",
    "editorIndentGuide.background1": "#282828",
    "editorIndentGuide.activeBackground1": "#525253",
    "editorWidget.background": "#282828",
    "editorWidget.border": "#525253",
    "editorSuggestWidget.background": "#282828",
    "editorSuggestWidget.selectedBackground": "#525253",
    "editorSuggestWidget.foreground": "#f2f4f8",
    "editorSuggestWidget.highlightForeground": "#78a9ff",
    "editorGroupHeader.tabsBackground": "#0d0d0d",
    "editorGroupHeader.tabsBorder": "#282828",
    "tab.activeBackground": "#161616",
    "tab.activeForeground": "#f2f4f8",
    "tab.inactiveBackground": "#0d0d0d",
    "tab.inactiveForeground": "#97999b",
    "sideBar.background": "#0d0d0d",
    "sideBar.foreground": "#dfdfe0",
    "sideBarSectionHeader.background": "#161616",
    "activityBar.background": "#0d0d0d",
    "activityBar.foreground": "#f2f4f8",
    "activityBarBadge.background": "#78a9ff",
    "activityBarBadge.foreground": "#161616",
    "statusBar.background": "#0d0d0d",
    "statusBar.foreground": "#dfdfe0",
    "titleBar.activeBackground": "#0d0d0d",
    "titleBar.activeForeground": "#f2f4f8",
    "panel.background": "#161616",
    "panel.border": "#525253",
    "terminal.background": "#161616",
    "terminal.foreground": "#f2f4f8",
    "terminalCursor.foreground": "#f2f4f8",
    "terminal.ansiBlue": "#78a9ff",
    "terminal.ansiCyan": "#33b1ff",
    "terminal.ansiGreen": "#25be6a",
    "terminal.ansiMagenta": "#be95ff",
    "terminal.ansiRed": "#ee5396",
    "terminal.ansiYellow": "#08bdba",
    "gitDecoration.addedResourceForeground": "#25be6a",
    "gitDecoration.modifiedResourceForeground": "#08bdba",
    "gitDecoration.deletedResourceForeground": "#ee5396",
    "diffEditor.insertedTextBackground": "#16161600",
    "diffEditor.removedTextBackground": "#16161600",
    "diffEditor.insertedLineBackground": "#16161600",
    "diffEditor.removedLineBackground": "#16161600"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#97999b" } },
    { "scope": ["string", "constant.other.placeholder"], "settings": { "foreground": "#25be6a" } },
    { "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null"], "settings": { "foreground": "#3ddbd9" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#be95ff" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#78a9ff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#33b1ff" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#f2f4f8" } }
  ]
}
